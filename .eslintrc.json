{
  "env": {
    "browser": true,
    "es2022": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "semi": ["error", "always"],
    "no-unused-vars": ["warn", { "varsIgnorePattern": "CI_LINTER_TEST" }],
    "no-console": "off"
  }
}
